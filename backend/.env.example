# Anthropic — used by the Claude Agent SDK
ANTHROPIC_API_KEY=

# Swiggy MCP servers (https://mcp.swiggy.com/builders/docs/reference/)
# Leave blank to run the agent without Swiggy (budget tools still work).
SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_INSTAMART_MCP_URL=https://mcp.swiggy.com/im

# Optional: a Swiggy OAuth access token for direct HTTP connection.
# Leave blank to use the mcp-remote proxy, which opens Swiggy's OAuth 2.1 PKCE
# login in your browser on first run (requires Node/npx).
SWIGGY_MCP_TOKEN=

# Defaults
MONTHLY_BUDGET_DEFAULT=8000
KANJOOS_MODEL=claude-opus-4-8
